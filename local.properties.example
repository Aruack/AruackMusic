# Aruack Music - Local Configuration Example
# Copy this file to `local.properties` and add your local configuration.
# DO NOT commit `local.properties` or keystores to version control.

# Location of the Android SDK
sdk.dir=C\:\\Users\\YourUsername\\AppData\\Local\\Android\\Sdk

# Spotify Client ID for metadata & streaming discovery
# Default client ID: ff184412120343ada935dbdbaf205475
SPOTIFY_CLIENT_ID=ff184412120343ada935dbdbaf205475

# Optional: Release Signing Keystore overrides
RELEASE_STORE_PASSWORD=aruackmusic2024
RELEASE_KEY_ALIAS=aruackrelease
RELEASE_KEY_PASSWORD=aruackmusic2024
