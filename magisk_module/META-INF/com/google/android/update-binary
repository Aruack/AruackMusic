#!/sbin/sh

#################
# Magisk Module #
#################

OUTFD=$2
ZIPFILE=$3

# Load utility functions
if [ -f /data/adb/magisk/util_functions.sh ]; then
  . /data/adb/magisk/util_functions.sh
else
  # Recovery mode fallback
  require_new_magisk() {
    ui_print "*******************************"
    ui_print " Please install Magisk v20.4+! "
    ui_print "*******************************"
    exit 1
  }
fi

# Execute module installer
install_module() {
  ui_print "- Installing Aruack Music System Priv-App"
}

export ZIPFILE
export OUTFD
exec /data/adb/magisk/busybox ash -c "$(unzip -p "$ZIPFILE" module.prop >/dev/null 2>&1 && unzip -p "$ZIPFILE" customize.sh)"
